{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "enabledManagers": ["dockerfile"],
  "dockerfile": {
    "managerFilePatterns": ["/^Dockerfile\\.template$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "base image & apk packages",
      "automerge": false
    },
    {
      "matchFileNames": ["Dockerfile.template"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ],
      "groupName": "base image & apk packages",
      "automerge": false
    }
  ]
}
